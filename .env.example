# Skopiuj do .env.local i uzupełnij. Na Vercelu wpisz te same zmienne w Settings → Environment Variables.

# MongoDB Atlas — connection string do klastra (baza wybierana przez MONGODB_DB)
MONGODB_URI="mongodb+srv://USER:HASLO@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="secret-santa"

# Gmail SMTP — hasło aplikacji (nie zwykłe hasło!), wymaga włączonej weryfikacji dwuetapowej
GMAIL_USER="twoj.adres@gmail.com"
GMAIL_APP_PASSWORD="abcd efgh ijkl mnop"

# Organizator(zy) — po przecinku. Ci ludzie widzą zakładkę „Organizator”.
ADMIN_EMAILS="twoj.adres@gmail.com"

# Publiczny adres aplikacji, używany w linkach w mailach (bez / na końcu).
# Lokalnie: http://localhost:3000. Na Vercelu: https://twoj-projekt.vercel.app
APP_URL="http://localhost:3000"

# Opcjonalnie: teksty pokazywane w aplikacji i mailach
EVENT_NAME="Secret Santa 2026"
EVENT_BUDGET="100 zł"
EVENT_DATE="24 grudnia"
